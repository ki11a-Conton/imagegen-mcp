{
  "name": "imagegen-mcp",
  "version": "0.7.0",
  "description": "MCP server that exposes chatgpt2api image generation and editing to DSH, with batched jobs, automatic routing and automatic concurrency. Streams SSE so it also works behind Cloudflare tunnels.",
  "type": "module",
  "bin": {
    "imagegen-mcp": "src/index.mjs"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "test": "node test/selftest.mjs && node test/integration.mjs",
    "test:unit": "node test/selftest.mjs",
    "test:integration": "node test/integration.mjs",
    "lint": "eslint src test .github/scripts",
    "format": "prettier --write \"src/**/*.mjs\" \"test/**/*.mjs\" \".github/**/*.{mjs,yml}\"",
    "format:check": "prettier --check \"src/**/*.mjs\" \"test/**/*.mjs\" \".github/**/*.{mjs,yml}\"",
    "verify": "npm run lint && npm run format:check && npm run check:emoji && npm test",
    "check:emoji": "node .github/scripts/check-emoji.mjs"
  },
  "files": [
    "src/",
    "test/",
    "install.ps1",
    "README.md",
    "AGENTS.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
